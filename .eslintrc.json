{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "indent": ["error", 4],
    "linebreak-style": ["error", "windows"],
    "quotes": ["error", "single"],
    "semi": ["error", "always"],
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-undef": "warn",
    "prefer-const": "error",
    "no-var": "error",
    "arrow-spacing": "error",
    "block-spacing": "error",
    "brace-style": ["error", "1tbs"],
    "comma-dangle": ["error", "never"],
    "key-spacing": "error",
    "keyword-spacing": "error",
    "space-before-blocks": "error",
    "space-in-parens": ["error", "never"]
  },
  "globals": {
    "window": "readonly",
    "document": "readonly",
    "console": "readonly",
    "require": "readonly",
    "module": "readonly",
    "exports": "readonly",
    "process": "readonly",
    "Buffer": "readonly",
    "__dirname": "readonly",
    "__filename": "readonly",
    "global": "readonly",
    "BaseManager": "readonly",
    "ServiceContainer": "readonly",
    "NotificationManager": "readonly",
    "ValidationManager": "readonly",
    "UIManager": "readonly",
    "AlgorithmManager": "readonly",
    "AccessibilityManager": "readonly"
  }
}
